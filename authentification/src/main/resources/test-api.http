### Login admin
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "username": "admin@univ-orleans.fr",
  "password": "admin"
}

> {%
    client.global.set("admin_token", response.body.accessToken);
    client.test("Request executed successfully", function () {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

### Creation utilisateur par admin
POST http://localhost:8080/api/auth/utilisateurs
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "username": "user@etu.univ-orleans.fr",
  "password": "user",
  "roles": "USER, ETUDIANT"
}

> {%
    client.test("Request executed successfully", function () {
        client.assert(response.status === 201, "Response status is not 201");
    });
%}

### Récupération profil utilisateur par admin
GET http://localhost:8080/api/auth/utilisateurs/user@etu.univ-orleans.fr
Authorization: Bearer {{admin_token}}

> {%
    client.test("Request executed successfully", function () {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

